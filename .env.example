# ─────────────────────────────────────────────────────────────
#  SceneSolver — Environment Variables
#  Copy this file to .env and fill in your values.
#  ⚠  Never commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# Flask secret key — used to sign session cookies.
# Generate a strong random value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secret_key

# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/scene_solver_db?retryWrites=true&w=majority

# ─── Optional ────────────────────────────────────────────────

# Set to 0 in production, 1 for local development (enables auto-reload and debug pages)
# FLASK_DEBUG=0

# Override the default port (used by some hosting platforms like Render)
# PORT=5000

